model Media {
    id                              String    @id @default(dbgenerated("gen_random_uuid()"))
    fileName                         String
    originalName                    String
    path                            String
    bucket                          String
    mimeType                        String
    extension                       String
    url                             String?
    size                            Int
    type                            MediaType
    width                           Int?
    height                          Int?
    duration                        Int?
    altText                         String?
    caption                         String?
    checksum                        String?
    createById                      String
    createdAt                       DateTime        @default(now())
    updatedAt                       DateTime        @updatedAt
    isDeleted                       Boolean         @default(false)
    deletedAt                       DateTime?
    permanentlyDeleteAt             DateTime?
}